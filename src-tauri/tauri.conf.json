{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open League Manager",
  "version": "2026.1111.3",
  "identifier": "com.openleaguemanager.olmanager",
  "build": {
    "beforeDevCommand": "node scripts/sync-data.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/sync-data.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open League Manager · Limón Edition 🍋 2026.1111.3",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": [
      "databases/world.json",
      "data/**/*",
      "../public/**/*",
      "../assets/simulation/*.json",
      "../assets/draft/*.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMzUxMjk1MEIzNUVEM0IKUldRNzdUVUxsUkkxMnNuS3hlYUV0Vkk4UUQzbVcxeVpTSWN6aWx4NUM3VkFkdkNGR3N5cEswUloK",
      "endpoints": [
        "https://github.com/ProphetLemon/OLManager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
